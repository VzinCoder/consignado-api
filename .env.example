# Copie para .env: cp .env.example .env
# Somente valores fictícios para desenvolvimento local.

NODE_ENV=development
LOG_LEVEL=info

# Postgres (docker-compose.dev.yml)
POSTGRES_USER=zelafin
POSTGRES_PASSWORD=zelafin
POSTGRES_DB=zelafin
DATABASE_URL=postgres://zelafin:zelafin@localhost:5432/zelafin

# Bancos fictícios (apps/bank-mocks)
BANK_MOCKS_PORT=4000
BANK_MOCKS_URL=http://localhost:4000
BANK_TIMEOUT_MS=5000
OFFER_TTL_HOURS=72

# Latência (ms) e taxa de erro (0 a 1) de cada banco fictício
IPE_LATENCY_MS=300
IPE_ERROR_RATE=0
MANDACARU_LATENCY_MS=800
MANDACARU_ERROR_RATE=0
JANGADA_LATENCY_MS=2500
JANGADA_ERROR_RATE=0
CARCARA_LATENCY_MS=600
CARCARA_ERROR_RATE=0.2

# Simulador: área administrativa e links enviados aos clientes
PUBLIC_APP_URL=http://localhost:3000
ADMIN_USERNAME=admin@zelafin.com.br
ADMIN_PASSWORD=zelafin-admin
SESSION_SECRET=troque-este-segredo-de-sessao-com-32-ou-mais-caracteres
